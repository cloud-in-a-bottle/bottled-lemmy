{
  database: {
    connection: "postgresql:///lemmy?host=/var/run/postgresql"
    pool_size: 10
  }
  hostname: "__HOSTNAME__"
  bind: "127.0.0.1"
  port: 8536
  tls_enabled: true
  setup: {
    admin_username: "__PROVISION_ADMIN_USERNAME__"
    admin_password: "__ADMIN_PASSWORD__"
    site_name: "OpenHost Lemmy"
    admin_email: "__PROVISION_ADMIN_USERNAME__@__HOSTNAME__"
  }
  federation: {
    concurrent_sends_per_instance: 1
  }
}
